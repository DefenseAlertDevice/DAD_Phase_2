<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_corner_bg"
>

    <!-- Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/_10sdp"
        android:textAlignment="center"
        android:textColor="@color/colorWhite"
        android:text="Dialog Title" />

    <!-- Message -->
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/colorWhite"
        android:layout_marginVertical="@dimen/_10sdp"
        android:textAlignment="center"
        android:paddingHorizontal="@dimen/_10sdp"
        android:text="This is the dialog message." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:id="@+id/dialog_divider1"
        android:background="@color/dialog_divider"
        />

    <Button
        android:id="@+id/dialog_action1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dialog_action_btn"
        android:background="@color/dialog_bg"
        android:text="Action 1"
        android:textSize="@dimen/_16sdp"
        android:textAllCaps="false"
        android:paddingVertical="@dimen/_10sdp"
    />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:id="@+id/dialog_divider2"
        android:layout_marginVertical="1dp"
        android:background="@color/dialog_divider"
        />

    <!-- Sign In Button -->
    <Button
        android:id="@+id/dialog_action2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Action 2"
        android:textSize="@dimen/_16sdp"
        android:textAllCaps="false"
        android:textColor="@color/dialog_action_btn"
        android:background="@color/dialog_bg"
        android:paddingVertical="@dimen/_10sdp"
    />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:id="@+id/dialog_divider3"
        android:layout_marginVertical="1dp"
        android:background="@color/dialog_divider"
        />
    <!-- Full Width Button -->
    <Button
        android:id="@+id/dialog_action3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dialog_action_btn"
        android:background="@color/dialog_bg"
        android:text="Action 3"
        android:textSize="@dimen/_16sdp"
        android:textAllCaps="false"
        android:paddingTop="@dimen/_10sdp"
    />

</LinearLayout>