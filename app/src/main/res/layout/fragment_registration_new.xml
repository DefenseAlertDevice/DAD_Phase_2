<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:padding="@dimen/_10sdp">

    <ImageView
        android:id="@+id/fragment_registration_iv_logo"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:src="@drawable/img_logo_white" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/_20sdp"
        android:layout_below="@+id/fragment_registration_iv_logo"
    >

        <TextView
            android:id="@+id/fragment_registration_tv_show_eula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/fragment_registration_show_eula"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/fragment_registration_tv_build_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="@dimen/_20sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/build_no"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_15sdp" />

        <Button
            android:id="@+id/fragment_registration_tv_create_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:text="@string/fragment_registration_create_account"
            android:layout_above="@+id/fragment_registration_tv_login_to_your_account"
            android:textColor="@color/colorOrange_new"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:background="@drawable/button_bg_white"
            android:textAllCaps="false"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fragment_registration_tv_login_to_your_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/fragment_registration_tv_show_eula"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_30sdp"
            android:layout_marginHorizontal="@dimen/_13sdp"
            android:text="@string/fragment_registration_login_to_your_account"
            android:textColor="@color/colorWhite"
            android:background="@drawable/button_bg_orange"
            android:textSize="@dimen/_14sdp"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </RelativeLayout>

</RelativeLayout>
